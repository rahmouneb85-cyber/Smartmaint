# Modèle du fichier .env : copiez-le en .env puis remplacez les valeurs.
# Le vrai fichier .env contient des secrets : il ne doit jamais être envoyé, partagé ni ajouté à une archive.

# ── Obligatoire ──
DATABASE_URL=mysql+pymysql://utilisateur:mot_de_passe@localhost:3306/smartmaint
SECRET_KEY=remplacer-par-64-caracteres-aleatoires
# Clé de chiffrement : indispensable pour relire les sauvegardes, à conserver en lieu sûr
CLE_CHIFFREMENT=remplacer-par-une-longue-phrase-aleatoire
IOT_API_KEY=remplacer-par-une-cle-aleatoire

# ── Environnement ──
# production : masque la documentation de l'API
ENVIRONNEMENT=developpement
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Notifications ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Boutons flottants des pages publiques ──
# numéro WhatsApp de l'entreprise au format international ; laisser vide pour masquer le bouton
WHATSAPP_ENTREPRISE=
ASSISTANT_PUBLIC=true

# ── Support : captures d'écran des demandes (dossier exclu de l'archive de livraison) ──
SUPPORT_DOSSIER=captures_support
SUPPORT_TAILLE_MAX_MO=5

# ── Room Live : 6 participants maximum par salle ; serveurs STUN/TURN (JSON) pour les connexions hors du réseau local ──
ROOM_MAX_PARTICIPANTS=6
ROOM_ICE_SERVERS=
ROOM_DOSSIER=fichiers_rooms
ROOM_FICHIER_MAX_MO=15

# ── Intelligence artificielle ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
COPILOTE_FOURNISSEUR=auto

# ── Sauvegardes ──
MYSQLDUMP_CHEMIN=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
MYSQL_CHEMIN=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
SAUVEGARDE_AUTO_HEURES=24
